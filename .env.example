# ==========================================
# PostgreSQL Database Credentials (Docker)
# ==========================================
POSTGRES_USER=protocol
POSTGRES_PASSWORD=protocol
POSTGRES_DB=protocol

# ==========================================
# Backend Application Settings
# ==========================================
DATABASE_URL=postgresql+psycopg://protocol:protocol@localhost:5432/protocol

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://giving-luck-production.up.railway.app

# ==========================================
# Browser-facing frontend settings
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==========================================
# AI Network Analysis Assistant
# ==========================================
# Never commit the real API key.
OPENAI_API_KEY=

# Model can be changed without changing application code.
OPENAI_MODEL=gpt-5-mini

# OpenAI-compatible Responses API base URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# Maximum time allowed for one AI request.
OPENAI_TIMEOUT_SECONDS=30