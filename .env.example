# ==========================================
# PostgreSQL Database Credentials (Docker)
# ==========================================
POSTGRES_USER=protocol
POSTGRES_PASSWORD=protocol
POSTGRES_DB=protocol

# ==========================================
# Backend Application Settings (FastAPI/Alembic)
# ==========================================
# URL-ul complet necesar pentru SQLAlchemy și Pydantic Settings
DATABASE_URL=postgresql+psycopg://protocol:protocol@localhost:5432/protocol

# Adaugă domeniul de producție la final pentru deployment (ex. Railway)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://giving-luck-production.up.railway.app

# ==========================================
# Browser-facing frontend settings
# ==========================================
# Pentru producție, înlocuiește cu URL-ul public al backend-ului
NEXT_PUBLIC_API_URL=http://localhost:8000
