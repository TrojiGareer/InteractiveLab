# Required by the backend. Use the database URL from your local setup.
DATABASE_URL=postgresql+psycopg://interactive:interactive@localhost:5432/interactive_lab

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# demo works without an API key; use provider only when you have configured one.
AI_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
